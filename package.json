{
  "name": "hybrid-clinic-receptionist",
  "version": "0.1.0",
  "private": true,
  "description": "IVR-first Spanish-language phone receptionist for a small general surgery clinic. On-prem STT/LLM/TTS; Twilio is a PSTN bridge only.",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "bash scripts/dev.sh",
    "test": "node --test src/server/**/*.test.js src/server/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
