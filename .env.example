# Copy to .env and fill in. Nothing here may point at a cloud STT/LLM/TTS service.
# NEVER put real credentials in this file — it is committed; .env is not.
# commit
# --- Node orchestrator ---
PORT=3000                      # Express + Media Streams WebSocket, binds 127.0.0.1 only
DB_PATH=var/clinic.db

# --- Speech sidecar (Python FastAPI, 127.0.0.1 only) ---
SPEECH_HOST=127.0.0.1
SPEECH_PORT=8081

# STT is Spanish-only for this deployment (see CLAUDE.md "Language requirement").
# Not configurable on purpose; listed here as documentation, the sidecar hardcodes es.
# WHISPER_LANGUAGE=es

# STT model/device. cuda + large-v3-turbo is ~190ms/turn on the 4070 Ti and
# fits beside qwen2.5:14b; on CUDA failure the sidecar falls back to
# small-on-CPU by itself. Set WHISPER_DEVICE=cpu on GPU-less machines.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16

# TTS engine + voice. PIPER_VOICE is chosen by listening to speech/samples/
# (scripts/make-voice-samples.py) BEFORE any prompts are cached — re-caching
# means re-testing the whole call flow. Leave blank until a voice is picked.
TTS_ENGINE=piper
PIPER_VOICE=

# Speaking pace. 1.0 is the voice's native rate; higher is slower. The
# caller base is mostly elderly, so prompts are slowed down by default
# (1.25). Changing this invalidates the cached prompts — restart the Node
# server, which re-synthesizes them at startup.
TTS_LENGTH_SCALE=1.25

# Optional intake questions. Set to false to skip asking about medication
# allergies (new-patient flow) and/or the reason for the visit (new-patient
# and follow-up flows) — the skipped field is stored as NULL. Anything other
# than the literal "false" means the question IS asked.
ASK_ALLERGIES=true
ASK_REASON=true

# Main menu control: false = DTMF-only (current), true = also accept spoken
# choices at the menu. Data-collection answers are always spoken either way.
MENU_SPEECH_ENABLED=false

# Field read-back confirmation ("¿Es correcto?") style: false (default) =
# ask the caller to just say sí o no; true = revert to also announcing
# "oprima uno... o dos...". Keys 1/2 keep working silently in both modes —
# this only changes the spoken instructions. The prompt is cached at
# startup, so restart the Node server after changing it.
FIELD_CONFIRM_DTMF=false

# --- Clinic identity (confirmation SMS only) ---
# Name defaults to "Clínica de Cirugía General" if unset. Address is
# optional — the SMS includes a "Dirección:" line only when it's set.
CLINIC_NAME=
CLINIC_ADDRESS=

# --- Ollama (local) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Twilio (PSTN/SMS bridge only — never sees transcripts or extracted fields) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Phone number of the on-call line for red-flag escalations
ESCALATION_NUMBER=
# Scheduling-team line for can't-understand handoffs (optional; log-only if unset)
SCHEDULING_NUMBER=
# Public wss:// URL of the /media endpoint (from your tunnel, e.g. ngrok):
# TWILIO_STREAM_URL=wss://<your-tunnel-host>/media
TWILIO_STREAM_URL=
